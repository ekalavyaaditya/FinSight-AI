# Express API
NODE_ENV=development
PORT=5000

# Local development database/cache URLs.
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/finsight_db?schema=public
REDIS_URL=redis://localhost:6379

# Use long, unique values in real environments.
JWT_SECRET=replace-with-a-long-random-jwt-secret
REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# FastAPI AI service URL.
AI_SERVICE_URL=http://localhost:8000
