# Express API
NODE_ENV=development
PORT=5000

# Local PostgreSQL database URL.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/finsight_db

# Redis is optional – leave blank to skip caching.
REDIS_URL=redis://localhost:6379

# Use long, unique values in real environments.
JWT_SECRET=replace-with-a-long-random-jwt-secret
REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# FastAPI AI service URL.
AI_SERVICE_URL=http://localhost:8000

# Optional: enables Gemini-backed insights in the AI service.
# GEMINI_API_KEY=your-gemini-api-key
